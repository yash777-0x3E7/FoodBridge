rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- USERS -----
    // Each user can read & write their OWN profile only.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ----- FOOD LISTINGS -----
    match /foodListings/{listingId} {

      // Any authenticated user can read listings
      allow read: if request.auth != null;

      // Only authenticated DONORS can create a listing, and only as themselves
      allow create: if request.auth != null
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.status == 'available'
        && getRole(request.auth.uid) == 'donor';

      // Update rules:
      //  (a) The listing OWNER (donor) can update their own listing freely.
      //  (b) Any RECEIVER can update ONLY to claim an available listing.
      allow update: if request.auth != null && (
        // (a) Owner updates
        resource.data.donorId == request.auth.uid

        // (b) Receiver claim
        || (
          getRole(request.auth.uid) == 'receiver'
          && resource.data.status == 'available'
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedBy == request.auth.uid
          // The donor-owned, immutable fields must not change during a claim
          && request.resource.data.donorId == resource.data.donorId
          && request.resource.data.foodTitle == resource.data.foodTitle
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.pickupAddress == resource.data.pickupAddress
        )
      );

      // Only the donor who created the listing can delete it
      allow delete: if request.auth != null && resource.data.donorId == request.auth.uid;
    }

    // Helper: read role from /users/{uid}
    function getRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
  }
}
